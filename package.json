{
  "name": "all-in-one-dev-toolkit",
  "version": "1.0.0",
  "description": "A fast, offline desktop toolbox for everyday developer utilities.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Anonymous Villain",
    "email": "thenewanonymousvillain@gmail.com",
    "url": "https://github.com/villainwasiqur"
  },
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/villainwasiqur/DevBench#readme",
  "bugs": {
    "url": "https://github.com/villainwasiqur/DevBench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/villainwasiqur/DevBench.git"
  },
  "build": {
    "appId": "com.anonymousvillain.devbench",
    "productName": "DevBench",
    "copyright": "Copyright © 2026 Anonymous Villain",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DevBench",
      "artifactName": "DevBench-${version}-Setup.${ext}"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node scripts/e2e-smoke.mjs",
    "budget": "node scripts/bundle-budget.mjs",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "he": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql-formatter": "^15.9.0",
    "uqr": "^0.1.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
